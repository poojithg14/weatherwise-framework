# Database
DB_USERNAME=postgres
DB_PASSWORD=password

# Spring profile: dev | prod
SPRING_PROFILE=dev

# ML Service
CORS_ORIGINS=http://localhost:8080,http://localhost:3000

# NWS API (no auth needed, but set a contact email)
NWS_USER_AGENT=WeatherWise/1.0 (your-email@example.com)

# OSRM (public instance or self-hosted)
OSRM_API_URL=http://router.project-osrm.org
